{
  "name": "lgtv2mqtt",
  "version": "3.0.2",
  "description": "Interface between LG webOS Smart TVs and MQTT",
  "type": "module",
  "main": "index.js",
  "preferGlobal": true,
  "bin": {
    "lgtv2mqtt": "index.js"
  },
  "files": [
    "index.js",
    "config.js",
    "lib/"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/lgtv2mqtt.git"
  },
  "keywords": [
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "home-automation",
    "home-assistant",
    "LG",
    "smart",
    "TV",
    "remote",
    "WebOS"
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://hobbyquaker.github.io)",
  "contributors": [
    "forty2 (https://github.com/forty2/)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hobbyquaker/lgtv2mqtt/issues"
  },
  "homepage": "https://github.com/hobbyquaker/lgtv2mqtt",
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "LGTV2MQTT",
    "needs": [
      "network"
    ],
    "serviceExtra": []
  },
  "dependencies": {
    "lgtv2": "^2.0.0",
    "mqtt-interfaces-core": "^0.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
